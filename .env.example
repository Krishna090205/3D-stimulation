# ==============================================================================
# AeroShield C-UAS - Environment Template (.env.example)
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
CORS_ORIGIN=*
DATABASE_DIR=./data
DATABASE_PATH=./data/drone_trainer.db

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_PORT=5173

# Base API URL used by the frontend to communicate with the backend.
# - Local Development: http://localhost:3001
# - Production Deployment (e.g. Render / Railway / Heroku): https://your-backend-api.onrender.com
VITE_API_BASE_URL=http://localhost:3001
