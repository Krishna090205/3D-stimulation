# ==============================================================================
# AeroShield C-UAS - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
# The port the Express backend server listens on
PORT=3001

# Application environment ('development' | 'production')
NODE_ENV=development

# Allowed CORS origins (use * for all, or comma-separated origins like http://localhost:5173,https://your-frontend.vercel.app)
CORS_ORIGIN=*

# Optional database path overrides (defaults to ./data/drone_trainer.db)
DATABASE_DIR=./data
DATABASE_PATH=./data/drone_trainer.db

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Dev server port for Vite
VITE_PORT=5173

# Base API URL used by the frontend to communicate with the backend.
# In local dev: http://localhost:3001 (or leave blank to use Vite's /api proxy)
# In production (e.g. deployed to Vercel/Render): set to your backend URL (e.g. https://aeroshield-api.onrender.com)
VITE_API_BASE_URL=http://localhost:3001
